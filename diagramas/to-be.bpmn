<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TOBE" targetNamespace="http://bpmn.io/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <collaboration id="Collaboration_TOBE">
    <participant id="Participant_Forwarder" name="Solicitante (Forwarder)" processRef="Process_Forwarder" />
    <participant id="Participant_Naviera" name="Naviera" processRef="Process_Naviera" />
    <messageFlow id="MF1" sourceRef="F_t3" targetRef="N_start" />
    <messageFlow id="MF2" sourceRef="N_endAlt" targetRef="F_catchAlt" />
    <messageFlow id="MF3" sourceRef="N_endOK" targetRef="F_catchOK" />
  </collaboration>
  <process id="Process_Forwarder" isExecutable="false">
    <startEvent id="F_start">
      <outgoing>FF1</outgoing>
    </startEvent>
    <task id="F_t1" name="Recibe solicitud de servicio para exportación">
      <incoming>FF1</incoming>
      <outgoing>FF2</outgoing>
    </task>
    <userTask id="F_t2" name="Consulta disponibilidad y tarifa referencial en el portal">
      <documentation>Mejoras 1 y 5: control relocation + tecnología integral. El solicitante ve la disponibilidad en línea.</documentation>
      <incoming>FF2</incoming>
      <outgoing>FF3</outgoing>
    </userTask>
    <sendTask id="F_t3" name="Envía solicitud de booking (formulario estandarizado)">
      <documentation>Mejoras 2 y 3: contact reduction + interfacing. Una sola interacción, con campos obligatorios.</documentation>
      <incoming>FF3</incoming>
      <incoming>FF10</incoming>
      <outgoing>FF4</outgoing>
    </sendTask>
    <eventBasedGateway id="F_ebg">
      <incoming>FF4</incoming>
      <outgoing>FF5</outgoing>
      <outgoing>FF7</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="F_catchOK" name="Recibe confirmación y detalles">
      <incoming>FF5</incoming>
      <outgoing>FF6</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <endEvent id="F_endOK" name="Booking confirmado">
      <incoming>FF6</incoming>
    </endEvent>
    <intermediateCatchEvent id="F_catchAlt" name="Recibe alternativas">
      <incoming>FF7</incoming>
      <outgoing>FF8</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <userTask id="F_t4" name="Evalúa alternativas">
      <documentation>Mejora 13: flujo alternativo cuando no hay disponibilidad.</documentation>
      <incoming>FF8</incoming>
      <outgoing>FF9</outgoing>
    </userTask>
    <exclusiveGateway id="F_g5" name="¿Acepta alternativa?">
      <incoming>FF9</incoming>
      <outgoing>FF10</outgoing>
      <outgoing>FF11</outgoing>
    </exclusiveGateway>
    <endEvent id="F_endNo" name="Sin booking">
      <incoming>FF11</incoming>
    </endEvent>
    <sequenceFlow id="FF1" sourceRef="F_start" targetRef="F_t1" />
    <sequenceFlow id="FF2" sourceRef="F_t1" targetRef="F_t2" />
    <sequenceFlow id="FF3" sourceRef="F_t2" targetRef="F_t3" />
    <sequenceFlow id="FF4" sourceRef="F_t3" targetRef="F_ebg" />
    <sequenceFlow id="FF5" sourceRef="F_ebg" targetRef="F_catchOK" />
    <sequenceFlow id="FF6" sourceRef="F_catchOK" targetRef="F_endOK" />
    <sequenceFlow id="FF7" sourceRef="F_ebg" targetRef="F_catchAlt" />
    <sequenceFlow id="FF8" sourceRef="F_catchAlt" targetRef="F_t4" />
    <sequenceFlow id="FF9" sourceRef="F_t4" targetRef="F_g5" />
    <sequenceFlow id="FF10" name="Sí" sourceRef="F_g5" targetRef="F_t3" />
    <sequenceFlow id="FF11" name="No" sourceRef="F_g5" targetRef="F_endNo" />
  </process>
  <process id="Process_Naviera" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_Plataforma" name="Plataforma de booking (sistema)">
        <flowNodeRef>N_start</flowNodeRef>
        <flowNodeRef>N_s1</flowNodeRef>
        <flowNodeRef>N_g1</flowNodeRef>
        <flowNodeRef>N_g1m</flowNodeRef>
        <flowNodeRef>N_s2</flowNodeRef>
        <flowNodeRef>N_g2</flowNodeRef>
        <flowNodeRef>N_alt</flowNodeRef>
        <flowNodeRef>N_endAlt</flowNodeRef>
        <flowNodeRef>N_s3</flowNodeRef>
        <flowNodeRef>N_pg1</flowNodeRef>
        <flowNodeRef>N_s4</flowNodeRef>
        <flowNodeRef>N_g3</flowNodeRef>
        <flowNodeRef>N_dt</flowNodeRef>
        <flowNodeRef>N_g3m</flowNodeRef>
        <flowNodeRef>N_pj</flowNodeRef>
        <flowNodeRef>N_s5</flowNodeRef>
        <flowNodeRef>N_g4</flowNodeRef>
        <flowNodeRef>N_s6</flowNodeRef>
        <flowNodeRef>N_s7</flowNodeRef>
        <flowNodeRef>N_endOK</flowNodeRef>
      </lane>
      <lane id="Lane_Ejecutivo" name="Ejecutivo comercial">
        <flowNodeRef>N_et</flowNodeRef>
      </lane>
      <lane id="Lane_Encargado" name="Encargado de Espacios">
        <flowNodeRef>N_e1</flowNodeRef>
        <flowNodeRef>N_endAlert</flowNodeRef>
        <flowNodeRef>N_bt</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="N_start" name="Recibe solicitud de booking">
      <outgoing>NF1</outgoing>
      <messageEventDefinition />
    </startEvent>
    <serviceTask id="N_s1" name="Valida datos de la solicitud y del contrato">
      <documentation>Mejoras 3 y 6: task elimination. Se elimina la revisión manual de detalles; solo pasan a revisión los casos inconsistentes.</documentation>
      <incoming>NF1</incoming>
      <outgoing>NF2</outgoing>
    </serviceTask>
    <exclusiveGateway id="N_g1" name="¿Requiere revisión manual?">
      <incoming>NF2</incoming>
      <outgoing>NF3</outgoing>
      <outgoing>NF4</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="N_g1m">
      <incoming>NF4</incoming>
      <incoming>NF5</incoming>
      <outgoing>NF6</outgoing>
    </exclusiveGateway>
    <userTask id="N_e1" name="Revisa y corrige solicitud inconsistente (case manager)">
      <documentation>Mejoras 4 y 14: cola con notificación al encargado; punto único de responsabilidad.</documentation>
      <incoming>NF3</incoming>
      <outgoing>NF5</outgoing>
    </userTask>
    <serviceTask id="N_s2" name="Verifica disponibilidad preliminar">
      <documentation>Mejoras 7 y 11: automatización + knock-out/resequencing. La disponibilidad se chequea antes de evaluar tarifa.</documentation>
      <incoming>NF6</incoming>
      <outgoing>NF7</outgoing>
    </serviceTask>
    <exclusiveGateway id="N_g2" name="¿Hay disponibilidad?">
      <incoming>NF7</incoming>
      <outgoing>NF8</outgoing>
      <outgoing>NF9</outgoing>
    </exclusiveGateway>
    <serviceTask id="N_alt" name="Ofrece alternativas (próxima salida, otro puerto, lista de espera)">
      <documentation>Mejora 13: exception + integration.</documentation>
      <incoming>NF8</incoming>
      <incoming>NF22</incoming>
      <outgoing>NF10</outgoing>
    </serviceTask>
    <endEvent id="N_endAlt" name="Envía alternativas al solicitante">
      <incoming>NF10</incoming>
      <messageEventDefinition />
    </endEvent>
    <serviceTask id="N_s3" name="Reserva temporal del espacio (con vencimiento)">
      <documentation>Mejora 9: evita conflictos entre solicitudes simultáneas del mismo recurso.</documentation>
      <incoming>NF9</incoming>
      <outgoing>NF11</outgoing>
    </serviceTask>
    <parallelGateway id="N_pg1">
      <incoming>NF11</incoming>
      <outgoing>NF12</outgoing>
      <outgoing>NF13</outgoing>
    </parallelGateway>
    <serviceTask id="N_s4" name="Calcula asignación por prioridad y flexibilidad">
      <documentation>Mejora 9: triage/order types + flexible assignment. Prioridad por tipo de cliente/contrato, volumen y urgencia (criterios a definir con el negocio).</documentation>
      <incoming>NF12</incoming>
      <outgoing>NF19</outgoing>
    </serviceTask>
    <exclusiveGateway id="N_g3" name="¿Caso estándar (10 o menos contenedores)?">
      <incoming>NF13</incoming>
      <outgoing>NF14</outgoing>
      <outgoing>NF15</outgoing>
    </exclusiveGateway>
    <serviceTask id="N_dt" name="Aplica tarifa por defecto">
      <incoming>NF14</incoming>
      <outgoing>NF16</outgoing>
    </serviceTask>
    <userTask id="N_et" name="Evalúa tarifa (rangos preaprobados)">
      <documentation>Mejora 10: exception + empower. Solo los casos excepcionales pasan por evaluación, con autoridad delegada.</documentation>
      <incoming>NF15</incoming>
      <outgoing>NF17</outgoing>
    </userTask>
    <exclusiveGateway id="N_g3m">
      <incoming>NF16</incoming>
      <incoming>NF17</incoming>
      <outgoing>NF18</outgoing>
    </exclusiveGateway>
    <parallelGateway id="N_pj">
      <documentation>Mejora 12: parallelism.</documentation>
      <incoming>NF18</incoming>
      <incoming>NF19</incoming>
      <outgoing>NF20</outgoing>
    </parallelGateway>
    <serviceTask id="N_s5" name="Revalida disponibilidad al confirmar">
      <documentation>Mejora 8: control addition.</documentation>
      <incoming>NF20</incoming>
      <outgoing>NF21</outgoing>
    </serviceTask>
    <exclusiveGateway id="N_g4" name="¿Sigue disponible?">
      <incoming>NF21</incoming>
      <outgoing>NF22</outgoing>
      <outgoing>NF23</outgoing>
    </exclusiveGateway>
    <serviceTask id="N_s6" name="Asigna buques, contenedores y BL; registra automáticamente">
      <documentation>Mejora 7: task automation. Elimina el registro manual de asignaciones.</documentation>
      <incoming>NF23</incoming>
      <outgoing>NF24</outgoing>
    </serviceTask>
    <serviceTask id="N_s7" name="Publica estado y notifica al solicitante">
      <documentation>Mejoras 5 y 14: estado visible en el portal y seguimiento.</documentation>
      <incoming>NF24</incoming>
      <outgoing>NF25</outgoing>
    </serviceTask>
    <endEvent id="N_endOK" name="Envía confirmación y detalles">
      <incoming>NF25</incoming>
      <messageEventDefinition />
    </endEvent>
    <sequenceFlow id="NF1" sourceRef="N_start" targetRef="N_s1" />
    <sequenceFlow id="NF2" sourceRef="N_s1" targetRef="N_g1" />
    <sequenceFlow id="NF3" name="Sí" sourceRef="N_g1" targetRef="N_e1" />
    <sequenceFlow id="NF4" name="No" sourceRef="N_g1" targetRef="N_g1m" />
    <sequenceFlow id="NF5" sourceRef="N_e1" targetRef="N_g1m" />
    <sequenceFlow id="NF6" sourceRef="N_g1m" targetRef="N_s2" />
    <sequenceFlow id="NF7" sourceRef="N_s2" targetRef="N_g2" />
    <sequenceFlow id="NF8" name="No" sourceRef="N_g2" targetRef="N_alt" />
    <sequenceFlow id="NF9" name="Sí" sourceRef="N_g2" targetRef="N_s3" />
    <sequenceFlow id="NF10" sourceRef="N_alt" targetRef="N_endAlt" />
    <sequenceFlow id="NF11" sourceRef="N_s3" targetRef="N_pg1" />
    <sequenceFlow id="NF12" sourceRef="N_pg1" targetRef="N_s4" />
    <sequenceFlow id="NF13" sourceRef="N_pg1" targetRef="N_g3" />
    <sequenceFlow id="NF14" name="Sí" sourceRef="N_g3" targetRef="N_dt" />
    <sequenceFlow id="NF15" name="No" sourceRef="N_g3" targetRef="N_et" />
    <sequenceFlow id="NF16" sourceRef="N_dt" targetRef="N_g3m" />
    <sequenceFlow id="NF17" sourceRef="N_et" targetRef="N_g3m" />
    <sequenceFlow id="NF18" sourceRef="N_g3m" targetRef="N_pj" />
    <sequenceFlow id="NF19" sourceRef="N_s4" targetRef="N_pj" />
    <sequenceFlow id="NF20" sourceRef="N_pj" targetRef="N_s5" />
    <sequenceFlow id="NF21" sourceRef="N_s5" targetRef="N_g4" />
    <sequenceFlow id="NF22" name="No" sourceRef="N_g4" targetRef="N_alt" />
    <sequenceFlow id="NF23" name="Sí" sourceRef="N_g4" targetRef="N_s6" />
    <sequenceFlow id="NF24" sourceRef="N_s6" targetRef="N_s7" />
    <sequenceFlow id="NF25" sourceRef="N_s7" targetRef="N_endOK" />
    <sequenceFlow id="NF26" sourceRef="N_bt" targetRef="N_endAlert" />
    <boundaryEvent id="N_bt" cancelActivity="false" attachedToRef="N_e1">
      <documentation>Mejora 4: alerta si la solicitud no se atiende a tiempo (ya no depende de revisar el correo).</documentation>
      <outgoing>NF26</outgoing>
      <timerEventDefinition>
        <timeDuration xsi:type="tFormalExpression">PT30M</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <endEvent id="N_endAlert" name="Alerta de solicitud sin atender">
      <incoming>NF26</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="BpmnDiagram_1">
    <bpmndi:BPMNPlane id="BpmnPlane_1" bpmnElement="Collaboration_TOBE">
      <bpmndi:BPMNShape id="Participant_Forwarder_di" bpmnElement="Participant_Forwarder" isHorizontal="true">
