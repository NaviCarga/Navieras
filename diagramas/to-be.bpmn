          <omgdc:Bounds x="1005" y="140" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_endNo_di" bpmnElement="F_endNo">
        <omgdc:Bounds x="1150" y="192" width="36" height="36" />
