        <omgdi:waypoint x="818" y="210" />
        <omgdi:waypoint x="880" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FF9_di" bpmnElement="FF9">
        <omgdi:waypoint x="980" y="210" />
