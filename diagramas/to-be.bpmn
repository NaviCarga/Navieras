      <bpmndi:BPMNShape id="Participant_Naviera_di" bpmnElement="Participant_Naviera" isHorizontal="true">
        <omgdc:Bounds x="160" y="330" width="2490" height="700" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Encargado_di" bpmnElement="Lane_Encargado" isHorizontal="true">
        <omgdc:Bounds x="190" y="790" width="2460" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ejecutivo_di" bpmnElement="Lane_Ejecutivo" isHorizontal="true">
        <omgdc:Bounds x="190" y="650" width="2460" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Plataforma_di" bpmnElement="Lane_Plataforma" isHorizontal="true">
        <omgdc:Bounds x="190" y="330" width="2460" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_start_di" bpmnElement="N_start">
        <omgdc:Bounds x="622" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="596" y="562" width="88" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_s1_di" bpmnElement="N_s1">
        <omgdc:Bounds x="700" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_g1_di" bpmnElement="N_g1" isMarkerVisible="true">
        <omgdc:Bounds x="850" y="515" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="818" y="470" width="114" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_g1m_di" bpmnElement="N_g1m" isMarkerVisible="true">
        <omgdc:Bounds x="965" y="515" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_e1_di" bpmnElement="N_e1">
        <omgdc:Bounds x="940" y="830" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_s2_di" bpmnElement="N_s2">
        <omgdc:Bounds x="1050" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_g2_di" bpmnElement="N_g2" isMarkerVisible="true">
        <omgdc:Bounds x="1200" y="515" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1180" y="568" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_alt_di" bpmnElement="N_alt">
        <omgdc:Bounds x="1290" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_endAlt_di" bpmnElement="N_endAlt">
        <omgdc:Bounds x="1440" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1408" y="415" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_s3_di" bpmnElement="N_s3">
        <omgdc:Bounds x="1290" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_pg1_di" bpmnElement="N_pg1">
