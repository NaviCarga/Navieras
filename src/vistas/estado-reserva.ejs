<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Estado de la reserva · Naviera Guerrero</title>
    <style>
      :root {
        color-scheme: light;
        --azul: #0b4f6c;
        --azul-claro: #e8f2f5;
        --borde: #c9d6db;
        --texto: #1d2b30;
        --verde: #1f7a4d;
        --rojo: #a33a2b;
      }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--texto);
        background: #f6f8f9;
      }
      header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 2rem;
        background: var(--azul);
        color: white;
      }
      header h1 {
        margin: 0;
        font-size: 1.25rem;
      }
      .marca {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      header nav {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
      }
      header nav a {
        color: white;
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      header nav a:hover {
        border-bottom-color: white;
      }
      header form {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
      }
      header select {
        padding: 0.35rem 0.5rem;
        border-radius: 0.35rem;
        border: 1px solid white;
      }
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
      }
      h2 {
        margin-top: 0;
      }
      .tarjeta {
        background: white;
        border: 1px solid var(--borde);
        border-radius: 0.75rem;
        padding: 1.5rem;
      }
      .encabezado-comprobante {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: start;
        gap: 1rem;
        border-bottom: 1px solid var(--borde);
        padding-bottom: 1rem;
        margin-bottom: 1rem;
      }
      .codigo {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--azul);
        margin: 0.2rem 0 0;
      }
      .estado {
        display: inline-block;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
      }
      .estado.confirmada {
        background: #e9f7ef;
        color: var(--verde);
      }
      .estado.rechazada {
        background: #fdecea;
        color: var(--rojo);
      }
      .estado.temporal {
        background: #fff4e5;
        color: #8a5300;
      }
      dl {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 0.9rem 1.5rem;
        margin: 0;
      }
      dt {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #5a6b72;
        font-weight: 600;
      }
      dd {
        margin: 0.2rem 0 0;
        font-size: 0.95rem;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.25rem;
      }
      th,
      td {
        padding: 0.55rem 0.6rem;
        text-align: left;
        border-top: 1px solid var(--borde);
        font-size: 0.9rem;
      }
      th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #5a6b72;
      }
      .aviso {
        padding: 0.9rem 1rem;
        border-radius: 0.5rem;
        margin-bottom: 1rem;
      }
      .aviso.ok {
        background: #e9f7ef;
        border: 1px solid #9fd8b4;
        color: var(--verde);
      }
      .aviso.pendiente {
        background: #fff4e5;
        border: 1px solid #f0c68a;
        color: #8a5300;
      }
      .acciones {
        margin-top: 1.5rem;
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
      }
      .acciones a {
        color: var(--azul);
      }
    form.consulta { display: flex; gap: 0.5rem; align-items: end; flex-wrap: wrap; margin-bottom: 1rem; }
      form.consulta input { padding: 0.4rem; }
      .posicion-grande { font-size: 1.4rem; font-weight: 700; }
    </style>
  </head>
  <body>
    <%- include('parciales/encabezado') %>
    <main>
      <%# CU-07 — Consultar estado de una reserva (HU-04 CA3) %>
      <h2>Consultar el estado de mi reserva</h2>

      <form method="get" action="/booking/estado" class="consulta">
        <label for="codigo">Código de reserva (Booking)</label>
        <input id="codigo" name="codigo" value="<%= codigo %>" placeholder="BK-2026-001" required />
        <button type="submit">Consultar</button>
      </form>

      <% if (mensaje) { %>
        <div class="aviso <%= error ? 'pendiente' : 'ok' %>"><%= mensaje %></div>
      <% } %>

      <% if (reserva) { %>
        <article class="tarjeta">
          <div class="encabezado-comprobante">
            <div>
              <span class="codigo"><%= reserva.codigoBooking %></span>
              <p><%= reserva.empresa.razonSocial %></p>
            </div>
            <span class="estado <%= reserva.estadoReserva.toLowerCase().replaceAll(' ', '-') %>">
              Estado: <%= reserva.estadoReserva %>
            </span>
          </div>

          <% if (reserva.estadoReserva === 'En lista de espera') { %>
            <p class="posicion-grande">Posición <%= reserva.posicionListaEspera %> en la lista de espera del viaje</p>
          <% } %>

          <dl>
            <div>
              <dt>Viaje</dt>
              <dd><%= reserva.viaje.codigoViaje %> · <%= reserva.buqueNombre %></dd>
            </div>
            <div>
              <dt>Ruta</dt>
              <dd><%= reserva.puertoOrigen %> → <%= reserva.puertoDestino %></dd>
            </div>
            <div>
              <dt>Zarpe</dt>
              <dd><%= reserva.viaje.fechaZarpe %></dd>
            </div>
            <div>
              <dt>Cantidad total</dt>
              <dd><%= reserva.cantidadTEU %> TEUs</dd>
            </div>
          </dl>

          <% if (reserva.estadoReserva === 'En lista de espera') { %>
            <form method="post" action="/booking/<%= reserva.id %>/cancelar">
              <button type="submit">Cancelar reserva en lista de espera</button>
            </form>
          <% } %>
        </article>

        <div class="acciones">
          <a href="/booking/<%= reserva.id %>/comprobante">Ver comprobante</a>
        </div>
      <% } %>
    </main>
  </body>
</html>
